# Remplace par tes vrais identifiants PostgreSQL locaux
# Format: postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db"

# Utilisé pour signer les tokens de connexion admin (JWT)
# Génère une vraie valeur aléatoire, ne garde pas cet exemple en prod
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"

# Port du serveur Express
PORT=4000

# URL du frontend (pour autoriser les requêtes CORS)
FRONTEND_URL="http://localhost:3000"

# Stockage des images projet : local pour le développement, supabase pour la production
STORAGE_PROVIDER="local"
SUPABASE_URL="https://ton-projet.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="a-renseigner-uniquement-sur-le-backend"
SUPABASE_STORAGE_BUCKET="portfolio-projects"
